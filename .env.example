# ── Backend (Loco) ─────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5433/reservazap
LOCO_ENV=development

# ── Pix ────────────────────────────────────────────────────────────
# mock (dev/demo) | mercadopago
PIX_PROVIDER=mock
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ── Frontend (Nuxt) ────────────────────────────────────────────────
# Base da API no navegador (passa pelo proxy do Nitro em /api)
NUXT_PUBLIC_API_BASE=/api
# URL interna do backend usada no SSR
NUXT_API_BASE_INTERNAL=http://127.0.0.1:3000/api
# Destino do proxy /api em dev
NUXT_API_PROXY_TARGET=http://127.0.0.1:3000
